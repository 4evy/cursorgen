{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "pip: install development dependencies",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-e", ".[dev]"],
      "problemMatcher": []
    },
    {
      "label": "pre-commit: check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pre_commit", "run", "--all-files"],
      "problemMatcher": []
    },
    {
      "label": "black: format check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "black", "--check", "."],
      "problemMatcher": []
    },
    {
      "label": "mypy: check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "mypy", "cursorgen", "fetch_samples.py"],
      "problemMatcher": []
    },
    {
      "label": "python: build",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "build"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
